#!/usr/bin/env python3
import json, socket, sys
cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
req = {"cmd": cmd}
if cmd in ("start", "stop"): req["assist"] = sys.argv[2]
if cmd == "load_waypoints": req["path"] = sys.argv[2]
s = socket.create_connection(("127.0.0.1", 15580), timeout=10)
s.sendall((json.dumps(req) + "\n").encode())
print(s.makefile().readline().strip())
